rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 홀·주방 주문 (직원 태블릿·주방 TV)
    match /orders/{id} {
      allow read, write: if request.auth != null;
    }
    // 정기 도시락 신청
    match /subscriptions/{id} {
      allow create: if true;
      allow get: if true;
      allow list, delete: if request.auth != null;
      allow update: if request.auth != null
        || (request.resource.data.phone == resource.data.phone
            && (request.resource.data.status in ['신청', '종료']
                || request.resource.data.status == resource.data.status));
    }
    // 정기 도시락 식단표
    match /dosirakMenus/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 포장·배달 손님 주문
    match /onlineOrders/{orderId} {
      allow create: if request.resource.data.status == 'new'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 60
                    && request.resource.data.total is number;
      allow get: if true;
      allow list, update, delete: if request.auth != null;
    }
    // 스탬프
    match /stamps/{phone} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }
    // 가게 설정 (영업시간 등)
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
